# --- Server ---
PORT=4100
NODE_ENV=development
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- MongoDB ---
# If Atlas fails with "querySrv ECONNREFUSED", your network's DNS blocks the lookup. Uncomment:
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Local: mongodb://127.0.0.1:27017/weekdeck
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/weekdeck?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/weekdeck

# --- Login tokens ---
# Long random text, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Region head / admin ---
# Lets you reset a team's PIN (POST /api/admin/reset-pin with header X-Admin-Secret).
# Leave empty to switch the admin endpoint off. At least 16 characters.
ADMIN_SECRET=

# --- AI ideas (optional) ---
# An Anthropic API key (platform.claude.com) turns on the "Ask AI" button for activities.
# Leave empty and everything else still works (suggestions from the team's own history need no AI).
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# --- Real cover photos (optional) ---
# Free key: sign up at https://pixabay.com, then open https://pixabay.com/api/docs/
# and copy the key shown under "Parameters" (key).
PIXABAY_API_KEY=
# (Or, if you already have one, a Pexels key works too.)
# PEXELS_API_KEY=
